<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="앱 가이드"
        android:textSize="18dp"
        android:padding="18dp"/>

    <!-- 1. QR코드 스캔하기 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/q1_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/q1_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/q1_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QR코드 스캔하기"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/q1_chevron"
                    android:layout_width="37dp"
                    android:layout_height="37dp"
                    app:srcCompat="@drawable/ic_arrow_drop_down"
                    app:tint="@color/selected_tab_color"
                    android:contentDescription="펼치기" />
            </LinearLayout>

            <View
                android:id="@+id/q1_divider"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginVertical="6dp"
                android:background="?attr/colorOutline"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/q1_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:src="@drawable/scan_guide" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- 2. QR 생성하기-->
    <com.google.android.material.card.MaterialCardView
