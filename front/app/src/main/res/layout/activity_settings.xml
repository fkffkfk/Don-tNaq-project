<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" >
    <!--  내용 컨테이너(스위치들): 툴바 아래 ~ 탈퇴하기 위까지 채움  -->
    <LinearLayout android:id="@+id/content_container" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:layout_marginTop="40dp" app:layout_constraintBottom_toTopOf="@id/tvwithdraw" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <!--  자동 로그인  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
            <TextView android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="자동 로그인" android:textColor="@color/text_color"
                android:textSize="20sp"/>
            <Switch android:id="@+id/switchAutoLogin"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:minHeight="0dp" android:padding="0dp"
                android:showText="false" android:splitTrack="false"
                android:switchMinWidth="0dp"
                android:thumb="@drawable/switch_thumb"
                android:thumbOffset="0dp"
                android:thumbTint="@null"
                android:track="@drawable/switch_track_selector"
                android:trackTint="@null"/>
        </LinearLayout>
        <!--  다크 모드  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="다크 모드" android:textColor="@color/text_color" android:textSize="20sp"/>
            <Switch android:id="@+id/switchDarkMode" android:layout_width="wrap_content" android:layout_height="24dp" android:minHeight="0dp" android:padding="0dp" android:showText="false" android:splitTrack="false" android:switchMinWidth="0dp" android:thumb="@drawable/switch_thumb" android:thumbOffset="0dp" android:thumbTint="@null" android:track="@drawable/switch_track_selector" android:trackTint="@null"/>
        </LinearLayout>
    </LinearLayout>
    <!--  탈퇴하기: 화면 맨 아래 중앙 고정  -->
    <TextView android:id="@+id/tvwithdraw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="탈퇴하기" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/unselected_tab_color" android:padding="18dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>