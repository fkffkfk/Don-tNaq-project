<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IntegrityQrActivity"
    android:padding="16dp">

    <EditText
        android:layout_marginTop="20dp"
        android:id="@+id/editUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="URL 입력"
        android:inputType="textUri"
        android:textColorHint="@color/logout"
        android:textColor="@color/text_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ✅ URL 입력 아래에 라디오버튼 세로 배치 -->
    <RadioGroup
        android:id="@+id/radioValidityGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/editUrl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:layout_marginTop="8dp"
        >

        <RadioButton
            android:id="@+id/radio1day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1일"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/radio7days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1주"
             />

        <RadioButton
            android:id="@+id/radio30days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1개월" />

        <RadioButton
            android:id="@+id/radio90days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3개월" />

        <RadioButton
            android:id="@+id/radio150days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6개월" />
    </RadioGroup>

    <Button
        android:id="@+id/btnGenerate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QR 생성"
        app:layout_constraintTop_toBottomOf="@id/radioValidityGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/colorPalette"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnGenerate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        >
        <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">
        <View
            android:id="@+id/colorBlack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#000000"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/colorMalcha"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#4B5E4A"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/colorBlue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#031888"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/colorSkyBlue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#6096FD"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white">
            <View
                android:id="@+id/colorMint"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#48C5D1"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorPink"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#FB788E"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorOrange"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#FAA788"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorBeige"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#CCAA88"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imageQr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginLeft="32dp"
            android:scaleType="centerInside"
            android:src="@drawable/example_qr"
            app:layout_constraintTop_toBottomOf="@id/colorPalette"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </LinearLayout>


    <Button
        android:id="@+id/btnQrSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QR 저장하기"
        app:layout_constraintTop_toBottomOf="@+id/colorPalette"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        />


</androidx.constraintlayout.widget.ConstraintLayout>
