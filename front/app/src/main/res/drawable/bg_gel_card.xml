<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ① 바탕: 보라 그라디언트 + 둥근 모서리 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <!-- top(연한) → bottom(진한) -->
            <gradient
                android:type="linear"
                android:angle="360"
                android:startColor="#BFD2FF"
                android:centerColor="#9860FA"
                android:endColor="@color/colorPrimary"
            />   <!-- 진보라 -->
        </shape>
    </item>

    <!-- ② 테두리/내부 그림자: 가장자리 살짝 어둡게 -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <stroke android:width="1dp"
                android:color="#33FFFFFF"/>
            <!-- 중심은 투명, 가장자리는 어둡게 -->
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="0.5" android:centerY="0.65"
                android:startColor="#00FFFFFF"
                android:centerColor="#00000000"
                android:endColor="#22505050"/>
        </shape>
    </item>

    <!-- ③ 상단 하이라이트: 젤 같은 광택 -->
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <size android:height="100dp"/> <!-- 광택 높이 -->
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#88FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

</layer-list>
